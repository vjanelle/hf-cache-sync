<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="HF Cache Sync" Manufacturer="HF Cache Sync contributors" Version="$(var.Version)" UpgradeCode="6b071154-d811-4f9b-bfc1-f52f5f1ec032" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="HF Cache Sync">
        <Component Id="Program" Guid="*">
          <File Id="Executable" Source="$(var.SourceDir)\hf-cache-sync.exe" KeyPath="yes" />
          <Environment Id="AddToPath" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="Main"><ComponentRef Id="Program" /></Feature>
  </Package>
</Wix>
